tenancy_ocid     = "ocid1.tenancy.oc1.."
user_ocid        = "ocid1.user.oc1.."
fingerprint      = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx" # substitua pelo seu fingerprint
private_key_path = "~/.oci/oci_api_key.pem"
region           = "sa-saopaulo-1" (ou us-ashburn-1 na minha nuvem)
compartment_ocid = "ocid1.compartment.oc1.."
vcn_id           = "ocid1.vcn.oc1."
subnet_id        = "ocid1.subnet.oc1."
nsg_id           = "ocid1.networksecuritygroup.oc1...."

ssh_cidr    = "000.000.000.000/32"  # --ssh-cidr (curl -s4 ifconfig.me | sed 's/$/\/32/')
shape       = "VM.Standard.A1.Flex" # mude a Shape caso dê erro de "Out of Capacity"
ocpus       = 2
memory      = 12

# GitOps (lidos pelo cloud-init no primeiro boot)
repo_ssh_url           = "git@github.com:<org>/<repo>.git"
ocir_user              = "<namespace>/<domínio>/<usuário>" # oci os ns get mostra o namespace
deploy_key_secret_ocid = "ocid1.vaultsecret.oc1.iad...." # segredo mediflow-deploy-key
ocir_token_secret_ocid = "ocid1.vaultsecret.oc1.iad...." # segredo com o auth token do OCIR

# DuckDNS (atualizado pelo Terraform, da sua máquina)
duckdns_domain = "mediflow-oci"
duckdns_token  = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" # duckdns.org, depois do login
